module TM1637_CONTROLLER_cv (input clk,rst, start_display,
                             input [15:0] display,
   			                 inout d_io,
   			                 output d_clk);

reg [7:0] data_in;
reg [1:0] state;
reg [2:0] step; 
reg stop_tx;          
reg start;
wire data_valid;
wire ready;
reg cmd1;

TM1637_MASTER1 uut (clk,rst,start,cmd1,data_in,stop_tx,d_io,ready,data_valid,d_clk);

parameter
         IDLE  = 2'd0,
         START = 2'd1,
         WAIT  = 2'd2;

function [7:0] hexseg;
    input [3:0] hex_value;
    begin
         case(hex_value)
             4'h0: hexseg = 8'h3f;
             4'h1: hexseg = 8'h06;
             4'h2: hexseg = 8'h5b;
             4'h3: hexseg = 8'h4f;
             4'h4: hexseg = 8'h66;
             4'h5: hexseg = 8'h6d;
             4'h6: hexseg = 8'h7d;
             4'h7: hexseg = 8'h07;
             4'h8: hexseg = 8'h7f;
             4'h9: hexseg = 8'h6f;
             4'hA: hexseg = 8'h77;
             4'hB: hexseg = 8'h7c;
             4'hC: hexseg = 8'h39;
             4'hD: hexseg = 8'h5e;
             4'hE: hexseg = 8'h79;
             4'hF: hexseg = 8'h71;
                default: hexseg = 8'h00;  
         endcase
    end  
endfunction

always @(posedge clk) 
begin
     if (~rst) 
     begin
          state      <= IDLE;
          start      <= 0;
          data_in    <= 0;
          step       <= 0;
          stop_tx    <= 0;
          cmd1       <= 1;
     end 
        
     else 
     begin
           start <= 0; 

          case (state)
                    IDLE: 
                    begin
                         if (start_display && ready) 
                         begin
                              step       <= 1;          
                              state      <= START; 
                         end
                    end

                    START: 
                    begin
                         start <= 1; 
                    
                        if(step == 1) // Cmd 1: Instruction
                        begin
                             data_in <= 8'h40;  // fixed value
                             stop_tx <= 1;
                        end
                        
                        else if (step == 2) // Cmd 2: Address
                        begin
                             data_in <= 8'hC0; //  Digit 1
                             stop_tx <= 0;
                        end
                        
                        else if (step == 3) // Cmd 3: DATA
                        begin
                             data_in <= hexseg(display[15:12]); // DATA  
                             stop_tx <= 0;
                        end
                        
                        else if (step == 4) // Cmd 3: DATA
                        begin
                             data_in <= hexseg(display[11:8]); // DATA  
                             stop_tx <= 0;
                        end
                        
                        else if (step == 5) // Cmd 3: DATA
                        begin
                             data_in <= hexseg(display[7:4]); // DATA  
                             stop_tx <= 0;
                        end
                        
                        else if (step == 6) // Cmd 3: DATA
                        begin
                             data_in <= hexseg(display[3:0]); // DATA  
                             stop_tx <= 1;
                        end
                        
                        else if (step == 47) // Cmd 4: Turn Display ON
                        begin
                             data_in <= 8'h8F; //ON
                             stop_tx <= 1;
                        end
                    
                        state <= WAIT;
                    end
                WAIT: 
                begin

                     if (data_valid)
                     begin
                         if (step == 7)
                         begin
                              step  <= 0;
                              state <= IDLE; 
                         end 
                         
                         else 
                         begin
                              step  <= step + 1; 
                              cmd1  <= 0;
                              state <= START;
                         end
                     end
                end
               
          endcase
     end
end
endmodule
